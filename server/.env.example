# Copy to .env locally: cp .env.example .env  (do not commit .env — it is gitignored)
#
# --- Stripe secret key (must match Stripe mode: test vs live, and stripe-config.js publishableKey) ---
# Dashboard → Developers → API keys
#
# Local / test payments:
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
#
# Production (set in Render dashboard — never commit live keys):
STRIPE_SECRET_KEY=sk_live_xxxxxxxx

# CORS: allowed browser Origin(s), comma-separated. Required for production so only your site calls the API.
# On Render, set to:
#   CLIENT_ORIGIN=https://letterleftbehind.com,https://www.letterleftbehind.com
# Local dev: leave unset (server allows any origin) or use:
#   CLIENT_ORIGIN=http://localhost:8000

PORT=3001
